{
  "name": "llm-proxy",
  "version": "0.1.0",
  "description": "Local LLM proxy server with multi-provider failover and app config management",
  "main": "dist/index.js",
  "bin": {
    "llm-proxy": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/add-shebang.js",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "electron:build": "cd electron && tsc",
    "electron": "npm run electron:build && electron --no-sandbox --disable-gpu --insecure-gpu-sandbox electron/dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "electron": "^31.0.0",
    "eslint": "^8.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
